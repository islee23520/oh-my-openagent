+++    if (readFileSync(lockPath, "utf-8") !== snapshot.raw) return false
+++    unlinkSync(lockPath)
+++    return true
+++  } catch (error) {
+++    if (error instanceof Error) return false
+++    throw error
+++  }
+++}
