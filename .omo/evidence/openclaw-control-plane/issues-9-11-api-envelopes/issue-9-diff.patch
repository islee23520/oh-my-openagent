+++  return readFileSync(getRuntimeEventStorePath(), "utf-8")
+++    .split("\n")
+++    .filter((line) => line.trim().length > 0)
+++    .map(parseRuntimeStoreLine)
+++    .filter((record): record is RuntimeEventStoreRecord => record !== null)
+++}
